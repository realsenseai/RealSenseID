// #cmakedefine RSID_SECURE     // phasing out secure mode support.

%ignore RealSenseID::AuthenticationCallback::OnFaceCroppedImage;
%ignore RealSenseID::EnrollmentCallback::OnFaceCroppedImage;
%ignore RealSenseID::AuthFaceprintsExtractionCallback::OnFaceCroppedImage;
%ignore RealSenseID::EnrollFaceprintsExtractionCallback::OnFaceCroppedImage;

// Define directors (allow C++ code to call Java code as well as the other way around)
%define CALLBACK_DIRECTOR(CLASSNAME)
%feature("director") RealSenseID::CLASSNAME;
%typemap(javaclassmodifiers) RealSenseID::CLASSNAME "public abstract class"
%javamethodmodifiers RealSenseID::CLASSNAME::CLASSNAME "protected"
%enddef

%define CALLBACK_METHOD(CLASSNAME, METHOD)
%javamethodmodifiers RealSenseID::CLASSNAME::METHOD "protected abstract"
%typemap(javaout) void RealSenseID::CLASSNAME::METHOD ";"
%enddef

CALLBACK_DIRECTOR(AuthenticationCallback)
CALLBACK_METHOD(AuthenticationCallback, OnResult)
CALLBACK_METHOD(AuthenticationCallback, OnHint)
CALLBACK_METHOD(AuthenticationCallback, OnFaceDetected)
// CALLBACK_METHOD(AuthenticationCallback, OnFaceCroppedImage)

CALLBACK_DIRECTOR(EnrollmentCallback)
CALLBACK_METHOD(EnrollmentCallback, OnResult)
CALLBACK_METHOD(EnrollmentCallback, OnHint)
CALLBACK_METHOD(EnrollmentCallback, OnProgress)
CALLBACK_METHOD(EnrollmentCallback, OnFaceDetected)
// CALLBACK_METHOD(EnrollmentCallback, OnFaceCroppedImage)

CALLBACK_DIRECTOR(AuthFaceprintsExtractionCallback)
CALLBACK_METHOD(AuthFaceprintsExtractionCallback, OnResult)
CALLBACK_METHOD(AuthFaceprintsExtractionCallback, OnHint)
CALLBACK_METHOD(AuthFaceprintsExtractionCallback, OnProgress)
CALLBACK_METHOD(AuthFaceprintsExtractionCallback, OnFaceDetected)
// CALLBACK_METHOD(AuthFaceprintsExtractionCallback, OnFaceCroppedImage)

CALLBACK_DIRECTOR(EnrollFaceprintsExtractionCallback)
CALLBACK_METHOD(EnrollFaceprintsExtractionCallback, OnResult)
CALLBACK_METHOD(EnrollFaceprintsExtractionCallback, OnHint)
CALLBACK_METHOD(EnrollFaceprintsExtractionCallback, OnProgress)
CALLBACK_METHOD(EnrollFaceprintsExtractionCallback, OnFaceDetected)
// CALLBACK_METHOD(EnrollFaceprintsExtractionCallback, OnFaceCroppedImage)

CALLBACK_DIRECTOR(FwUpdater::EventHandler)
CALLBACK_METHOD(FwUpdater::EventHandler, OnProgress)

CALLBACK_DIRECTOR(PreviewImageReadyCallback)
CALLBACK_METHOD(PreviewImageReadyCallback, OnPreviewImageReady)
CALLBACK_METHOD(PreviewImageReadyCallback, OnSnapshotImageReady)

// CALLBACK_DIRECTOR(RealSenseID::LogCallback)
// CALLBACK_METHOD(RealSenseID::LogCallback, OnLog)

