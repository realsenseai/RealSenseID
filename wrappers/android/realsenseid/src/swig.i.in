%include "@RealSenseID_HEADERS_FOLDER@/FwUpdater.h"
%include "@RealSenseID_HEADERS_FOLDER@/Version.h"
using namespace RealSenseID;


%extend RealSenseID::Image {

    jbyteArray GetImageBuffer() {
        if (!$self->buffer || $self->size <= 0) {
            ALOGD("Buffer is null or size is invalid");
            return nullptr;
        }

        if ($self->width <= 0 || $self->height <= 0 || $self->stride <= 0) {
            ALOGD("Invalid dimensions: width=%d, height=%d, stride=%d", $self->width, $self->height, $self->stride);
            return nullptr;
        }

        if (!cached_jvm) {
            throw std::runtime_error("JVM has not been initialized");
        }

        JNIEnv *env = JNU_GetEnv();
        jbyteArray result = env->NewByteArray($self->size);
        if (result == nullptr) {
            ALOGD("Failed to allocate Java byte array");
            return nullptr;
        }

        env->SetByteArrayRegion(result, 0, $self->size, reinterpret_cast<const jbyte*>($self->buffer));
        return result;
    }


    /**
    * Returns pixels converted to ARGB format ready for use with Android Bitmap.
    *
    * <p>This method extracts pixel data from the internal BGR buffer and converts
    * it to the ARGB format required for Android Bitmap objects. The alpha channel
    * is set to full opacity (255).</p>
    *
    * <p>Example usage:</p>
    * <pre>{@code
    * int[] bitmapPixels = image.GetBitmapPixels();
    * int width = image.getSize();
    * int height = image.getHeight();
    *
    * // Create bitmap from the pixel data
    * Bitmap bitmap = Bitmap.createBitmap(
    *     bitmapPixels, width, height, Bitmap.Config.ARGB_8888);
    * }</pre>
    *
    * @return New array containing the ARGB pixel data, sized width × height.
    */
    jintArray GetBitmapPixels() {
        if ($self->buffer == nullptr || $self->size <= 0) {
            ALOGD("Buffer is null or size is invalid");
            return nullptr;
        }

        if (!cached_jvm) {
            throw std::runtime_error("JVM has not been initialized");
        }

        JNIEnv *env = JNU_GetEnv();
        bool attached = false;

        int width = $self->width;
        int height = $self->height;
        int stride = $self->stride;

        if (width <= 0 || height <= 0 || stride <= 0) {
            ALOGD("Invalid dimensions: width=%d, height=%d, stride=%d", width, height, stride);
            return nullptr;
        }

        int totalPixels = width * height;
        int alpha = 0xFF;

        std::vector<int> argbArray;
        try {
            argbArray.resize(totalPixels);
        } catch (const std::bad_alloc&) {
            ALOGD("Failed to allocate memory for argbArray");
            return nullptr;
        }

        #pragma omp parallel for private(row, col, bIndex, blue, green, red)
        for (int i = 0; i < totalPixels; i++) {
            int row = i / width;
            int col = i % width;

            int bIndex = row * stride + (col * 3);
            if (bIndex + 2 >= stride * height) {
                ALOGD("Detected out-of-bounds access in buffer at index %d", bIndex);
                break;
            }

            int blue = static_cast<unsigned char>($self->buffer[bIndex  + 2]);
            int green = static_cast<unsigned char>($self->buffer[bIndex + 1]);
            int red = static_cast<unsigned char>($self->buffer[bIndex]);

            argbArray[i] = (alpha << 24) | (red << 16) | (green << 8) | blue;
        }

        // Create jintArray to return to Java (we don't want bytes here!)
        jintArray result = env->NewIntArray(totalPixels);
        if (result == nullptr) {
            ALOGD("Failed to allocate Java int array");
        } else {
            env->SetIntArrayRegion(result, 0, totalPixels, argbArray.data());
        }

        return result;
    }
}   // %extend
