<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.preview.PreviewFragment">

  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/video_group"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      tools:context=".ui.preview.PreviewFragment">

    <TextureView
        android:id="@+id/video_texture_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:context=".ui.preview.PreviewFragment" />

    <View
        android:id="@+id/video_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:tag="video_overlay"
        app:layout_constraintBottom_toBottomOf="@+id/video_texture_view"
        app:layout_constraintEnd_toEndOf="@+id/video_texture_view"
        app:layout_constraintStart_toStartOf="@+id/video_texture_view"
        app:layout_constraintTop_toTopOf="@+id/video_texture_view"
        tools:context=".ui.preview.PreviewFragment" />

    <ProgressBar
        android:id="@+id/progress_spinner"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/video_texture_view"
        app:layout_constraintEnd_toEndOf="@+id/video_texture_view"
        app:layout_constraintStart_toStartOf="@+id/video_texture_view"
        app:layout_constraintTop_toTopOf="@+id/video_texture_view"
        tools:context=".ui.preview.PreviewFragment" />

  </androidx.constraintlayout.widget.ConstraintLayout>

  <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/hint"
      android:layout_width="match_parent"
      android:layout_height="60dp"
      android:background="@android:color/transparent"
      android:gravity="center"
      android:textAlignment="center"
      android:textColor="@color/white"
      android:textSize="20sp"
      app:layout_constraintTop_toTopOf="parent"
      tools:text="Hint Placeholder" />

  <LinearLayout
      android:id="@+id/rsid_buttons"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="5dp"
      android:layout_marginEnd="5dp"
      android:gravity="center"
      android:orientation="vertical"
      app:layout_constraintBottom_toBottomOf="@+id/video_group">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_enroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:text="@string/button_enroll"
        android:visibility="gone"
        app:cornerRadius="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_enroll_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:text="@string/enroll_image"
        app:cornerRadius="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_authenticate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:text="@string/button_authenticate"
        android:visibility="gone"
        app:cornerRadius="8dp" />

  </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>