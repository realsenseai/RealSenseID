<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.firmware.FirmwareFragment">

  <com.google.android.material.card.MaterialCardView
      android:id="@+id/fw_version_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_margin="1dp"
      app:cardBackgroundColor="?attr/colorSurface"
      app:cardCornerRadius="5dp"
      app:cardElevation="5dp"
      app:cardMaxElevation="5dp"
      app:cardPreventCornerOverlap="true"
      app:cardUseCompatPadding="true"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">


      <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_weight="1">


        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_firmware_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:text="@string/firmware_version"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_refresh"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Refresh"
            android:paddingStart="150dp"
            android:paddingTop="15dp"
            app:icon="@android:drawable/ic_popup_sync"
            app:iconGravity="textStart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_firmware"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="40dp"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_firmware_header"
            tools:text="Version Placeholder" />


      </androidx.constraintlayout.widget.ConstraintLayout>


      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="40dp"
            android:paddingTop="20dp"
            android:text="@string/host_version"
            android:textSize="14sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="60dp"
            android:textSize="12sp"
            tools:text="Version Placeholder" />
      </LinearLayout>

    </LinearLayout>

  </com.google.android.material.card.MaterialCardView>

  <com.google.android.material.card.MaterialCardView
      android:id="@+id/fetch_device_logs_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_margin="1dp"
      app:cardBackgroundColor="?attr/colorSurface"
      app:cardCornerRadius="5dp"
      app:cardElevation="5dp"
      app:cardMaxElevation="5dp"
      app:cardPreventCornerOverlap="true"
      app:cardUseCompatPadding="true"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/fw_version_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <com.google.android.material.textview.MaterialTextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:padding="20dp"
          android:text="@string/log_management"
          android:textSize="14sp" />

      <com.google.android.material.button.MaterialButton
          android:id="@+id/button_fetch_device_logs"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginHorizontal="20dp"
          android:paddingHorizontal="20dp"
          android:text="@string/fetch_device_logs"
          app:icon="@drawable/permissionx_ic_alert"
          app:iconGravity="textStart"
          app:iconSize="14dp" />
    </LinearLayout>

  </com.google.android.material.card.MaterialCardView>

  <com.google.android.material.card.MaterialCardView
      android:id="@+id/flash_firmware_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_margin="1dp"
      app:cardBackgroundColor="?attr/colorSurface"
      app:cardCornerRadius="5dp"
      app:cardElevation="5dp"
      app:cardMaxElevation="5dp"
      app:cardPreventCornerOverlap="true"
      app:cardUseCompatPadding="true"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/fetch_device_logs_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <com.google.android.material.textview.MaterialTextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:padding="20dp"
          android:text="@string/flash_firmware"
          android:textSize="14sp" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_flash_firmware_resource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:paddingHorizontal="20dp"
            android:text="@string/flash_res"
            app:icon="@drawable/zip"
            app:iconGravity="textStart"
            app:iconSize="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_flash_firmware"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:paddingHorizontal="20dp"
            android:text="@string/flash"
            app:icon="@drawable/download"
            app:iconGravity="textStart"
            app:iconSize="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_flash_firmware_select_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:paddingHorizontal="20dp"
            android:text="@string/flash_file"
            app:icon="@drawable/zip"
            app:iconGravity="textStart"
            app:iconSize="14dp" />
      </LinearLayout>
    </LinearLayout>

  </com.google.android.material.card.MaterialCardView>

  <FrameLayout
      android:id="@+id/circular_progress"
      android:visibility="gone"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_centerInParent="true"
      android:padding="12dp"
      android:elevation="10dp"
      android:clickable="true"
      android:focusable="true"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:layout_gravity="center"
        app:indicatorColor="@android:color/holo_blue_bright"
        app:trackColor="@android:color/darker_gray" />
  </FrameLayout>

