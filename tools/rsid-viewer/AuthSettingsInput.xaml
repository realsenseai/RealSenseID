<Window x:Class="rsid_wrapper_csharp.AuthSettingsInput"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rsid_wrapper_csharp"
        mc:Ignorable="d"
        Title="Settings" Height="730"
        Width="590"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBGBrush}"
        MouseDown="Window_MouseDown" BorderBrush="{DynamicResource SecondaryColorBrush}" BorderThickness="1" UseLayoutRounding="True">

    <Window.Resources>
        <local:ModeToVisibilityConverter x:Key="ModeToVisibilityConverter" />
    </Window.Resources>

    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0">
                <TextBlock x:Name="Title1" HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="16" FontWeight="Medium" Text="Settings" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" d:LayoutOverrides="LeftPosition, RightPosition" Margin="24,24,0,32"/>
                
                <!-- Mode Selector -->
                <Grid x:Name="ModeGrid" VerticalAlignment="Top" Margin="24,0,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mode" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                    <ComboBox x:Name="ModeSelector" Grid.Column="1" SelectionChanged="ModeSelector_SelectionChanged" Style="{DynamicResource ComboBoxStyle1}" FontSize="14" Foreground="{DynamicResource PrimaryText}">
                        <ComboBoxItem Content="Face" Tag="FA"/>
                        <ComboBoxItem Content="Person" Tag="Person"/>
                        <ComboBoxItem Content="Other" Tag="Other"/>
                    </ComboBox>
                </Grid>
                
                <!-- Basic Settings Section -->
                <Expander x:Name="BasicExpander" Header="Basic" IsExpanded="{Binding IsBasicExpanded, Mode=TwoWay}" Margin="24,0,24,8" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold">
                    <StackPanel x:Name="BasicSettingsPanel" Margin="10,10,0,0" TextElement.FontWeight="Normal">
                        <!-- Unified Operation Settings -->
                        <StackPanel x:Name="OperationSettings">
                            <Grid VerticalAlignment="Top" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Operation" FontWeight="Bold" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="14"/>
                                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="Operation_All" Content="Auth" GroupName="OperationMode" VerticalAlignment="Center" Click="RadioButton_Click"
                                                 Foreground="{DynamicResource PrimaryText}" Margin="0,0,16,0"
                                                 Style="{DynamicResource RadioButtonStyle1}" FontSize="14" ToolTip="Run all face authentication flows"
                                                 Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=OperationFace}"/>

                                    <RadioButton x:Name="Operation_DetectionOnly" Content="Face" GroupName="OperationMode" VerticalAlignment="Center" Click="RadioButton_Click"
                                                 Foreground="{DynamicResource PrimaryText}" Margin="0,0,16,0"
                                                 Style="{DynamicResource RadioButtonStyle1}" FontSize="14" ToolTip="Run only face detection flow"
                                                 Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=OperationFace}"/>

                                    <RadioButton x:Name="Operation_SpoofOnly" Content="Spoof" GroupName="OperationMode" VerticalAlignment="Center" Click="RadioButton_Click"
                                                 Foreground="{DynamicResource PrimaryText}" Margin="0,0,16,0"
                                                 Style="{DynamicResource RadioButtonStyle1}" FontSize="14" ToolTip="Run only anti-spoofing flow"
                                                 Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=OperationFace}"/>

                                    <RadioButton x:Name="Operation_RecognitionOnly" Content="Recog" GroupName="OperationMode" VerticalAlignment="Center" Click="RadioButton_Click"
                                                 Foreground="{DynamicResource PrimaryText}" Margin="0,0,16,0"
                                                 Style="{DynamicResource RadioButtonStyle1}" FontSize="14" ToolTip="Run only face recognition flow"
                                                 Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=OperationFace}"/>

                                    <RadioButton x:Name="Operation_PersonOnly" Content="Person" GroupName="OperationMode" VerticalAlignment="Center" Click="RadioButton_Click"
                                                 Foreground="{DynamicResource PrimaryText}" Margin="0,0,16,0"
                                                 Style="{DynamicResource RadioButtonStyle1}" FontSize="14" ToolTip="Run person detection flow"
                                                 Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=OperationPerson}"/>

                                    <RadioButton x:Name="Operation_PoseOnly" Content="Pose" GroupName="OperationMode" VerticalAlignment="Center" Click="RadioButton_Click"
                                                 Foreground="{DynamicResource PrimaryText}" Margin="0,0,16,0"
                                                 Style="{DynamicResource RadioButtonStyle1}" FontSize="14" ToolTip="Run person pose estimation flow"
                                                 Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=OperationPerson}"/>

                                    <RadioButton x:Name="Operation_BodyPartOnly" Content="Tailgate" GroupName="OperationMode" VerticalAlignment="Center" Click="RadioButton_Click"
                                                 Foreground="{DynamicResource PrimaryText}" Margin="0,0,16,0"
                                                 Style="{DynamicResource RadioButtonStyle1}" FontSize="14" ToolTip="Run human body part detection flow"
                                                 Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=OperationPerson}"/>

                                    <RadioButton x:Name="Operation_BarcodeOnly" Content="Barcode" GroupName="OperationMode" VerticalAlignment="Center" Click="RadioButton_Click"
                                                 Foreground="{DynamicResource PrimaryText}" Margin="0,0,16,0"
                                                 Style="{DynamicResource RadioButtonStyle1}" FontSize="14" ToolTip="Run barcode decoding flow"
                                                 Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=OperationOther}"/>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Matcher confidence level (Anti Spoofing) -->
                        <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=AntiSpoofing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Confidence" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Anti Spoofing" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="ConfidenceHigh" Click="CheckCanApply" Content="High" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" IsChecked="True" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                <RadioButton x:Name="ConfidenceEnhanced" Click="CheckCanApply" Content="Enhanced" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                <RadioButton x:Name="ConfidenceStandard" Click="CheckCanApply" Content="Standard" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"  Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                            </WrapPanel>
                        </Grid>

                        <!-- dump mode (Frame Dumps) -->
                        <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=FrameDumpsGroup}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DumpingLabel" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Frame Dumps" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="DumpModeNone" Click="CheckCanApply" Content="Off" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" IsChecked="True" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                <RadioButton x:Name="DumpModeFace" Click="CheckCanApply" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=FrameDumpsFaceCropped}" Content="Crop" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                <RadioButton x:Name="DumpModeFull" Click="CheckCanApply" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=FrameDumpsFull}" Content="Full" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                <RadioButton x:Name="DumpModeDebug" Click="CheckCanApply" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=FrameDumpsDebug}" Content="Debug" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                            </WrapPanel>
                        </Grid>

                        <!-- camera rotation -->
                        <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=CameraRotation}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CameraRotationLabel" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Camera Rotation" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="CameraRotation0" Content="0°" Click="CameraRotation_Click" Foreground="{DynamicResource PrimaryText}" IsChecked="True" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                <RadioButton x:Name="CameraRotation90" Content="90°" Click="CameraRotation_Click" Foreground="{DynamicResource PrimaryText}" IsChecked="True" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                <RadioButton x:Name="CameraRotation180" Content="180°" Click="CameraRotation_Click" Foreground="{DynamicResource PrimaryText}" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                <RadioButton x:Name="CameraRotation270" Content="270°" Click="CameraRotation_Click" Foreground="{DynamicResource PrimaryText}" IsChecked="True" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                            </WrapPanel>
                        </Grid>

                        <!-- Face selection policy -->
                        <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=FaceSelectionSingle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FaceSelectionPolicyLabel" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Face Selection" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="FaceSelectionPolicySingle" Click="CheckCanApply" Content="Single" VerticalAlignment="Center" IsChecked="True" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                <RadioButton x:Name="FaceSelectionPolicyAll" Click="CheckCanApply" Content="Multi" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                            </WrapPanel>
                        </Grid>

                        <!-- person motion mode -->
                        <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=MotionMode}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PersonMotionModeStatic" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Person Motion Mode" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="StaticMode" Content="Static" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" IsChecked="True" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Click="PersonMotionMode_Click" Margin="0,0,16,0"/>
                                <RadioButton x:Name="WalkthroughMode" Content="Walkthrough" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" IsChecked="False" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Click="PersonMotionMode_Click" Margin="0,0,16,0"/>
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Advanced Settings Section -->
                <!-- Defaulting to collapsed as requested to hide less frequently used options -->
                <Expander x:Name="AdvancedExpander" Header="Advanced" IsExpanded="{Binding IsAdvancedExpanded, Mode=TwoWay}" Margin="24,0,24,8" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="SemiBold">
                    <StackPanel x:Name="AdvancedSettingsPanel" Margin="10,10,0,0" TextElement.FontWeight="Normal">
                        <StackPanel x:Name="Device">
                            <!-- host mode -->
                            <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=DBManagement}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ServerModeLabel" HorizontalAlignment="Left" TextWrapping="Wrap" Text="DB Management" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="ServerModeNo" Content="On Device" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="ServerModeYes" Content="On Host" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" IsChecked="True" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                </WrapPanel>
                            </Grid>

                            <!-- preview format -->
                            <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=Preview}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="previewModeLabel" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Preview Format" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="PreviewModeMJPEG_1080P" Content="1080p" VerticalAlignment="Center"
                                     Foreground="{DynamicResource PrimaryText}"
                                     IsChecked="True" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" ToolTip="MJPEG 1080P" Margin="0,0,16,0"/>

                                    <RadioButton x:Name="PreviewModeMJPEG_720P" Content="720p" VerticalAlignment="Center"
                                     Foreground="{DynamicResource PrimaryText}"
                                     Style="{DynamicResource RadioButtonStyle1}" FontSize="14" ToolTip="MJPEG 720P" Margin="0,0,16,0"/>
                                </WrapPanel>
                            </Grid>

                            <!-- distance limit -->
                            <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding DistanceSettingsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DistanceLimitLabel" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Distance Limit (cm)" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="DistanceLimitSlider" Width="220" Minimum="0" Maximum="150" SmallChange="1" LargeChange="10" TickFrequency="25" TickPlacement="BottomRight" IsSnapToTickEnabled="False" ValueChanged="CheckCanApply" VerticalAlignment="Center" ToolTip="0 = no limit, 1-150 = max distance in cm">
                                        <Slider.Resources>
                                            <Style TargetType="TickBar">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryText}"/>
                                                <Setter Property="Height" Value="8"/>
                                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                            </Style>
                                        </Slider.Resources>
                                    </Slider>
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="Bold" Margin="12,0,8,0" MinWidth="32" TextAlignment="Right" Text="{Binding ElementName=DistanceLimitSlider, Path=Value, StringFormat={}{0:0}}"/>
                                    <TextBlock Text="(0 = no limit)" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Frontal face policy -->
                            <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=FrontalFacePolicy}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FrontalPolicy" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Frontal Face Policy" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="FrontalStrict" Click="CheckCanApply" Content="Strict" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" IsChecked="True" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="FrontalModerate" Click="CheckCanApply" Content="Moderate" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="FrontalNone" Click="CheckCanApply" Content="None" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" Style="{DynamicResource RadioButtonStyle1}" FontSize="14" Margin="0,0,16,0"/>
                                </WrapPanel>
                            </Grid>

                            <!-- features-->
                            <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=FeaturesGroup}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FeaturesLabel" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Features" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="Feature_Rectangle" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=FeaturesRect}" Content="Rectangle" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" IsChecked="True" Style="{DynamicResource CheckBoxStyle1}" FontSize="14" ToolTip="Get rectangle arround face/person" Margin="0,0,16,0"/>
                                    <CheckBox x:Name="Feature_Landmarks" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=FeaturesLM}" Content="Landmarks" AutomationProperties.AutomationId="LandmarksCheckbox" Click="LandmarksCheckbox_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" IsChecked="False" Style="{DynamicResource CheckBoxStyle1}" FontSize="14" ToolTip="Get face/person landmarks" Margin="0,0,16,0"/>
                                    <CheckBox x:Name="Feature_Distance" Visibility="{Binding DistanceSettingsVisibility}" Content="Distance" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" IsChecked="False" Style="{DynamicResource CheckBoxStyle1}" FontSize="14" ToolTip="Get distance" Margin="0,0,16,0"/>
                                </WrapPanel>
                            </Grid>

                            <!-- max spoof attempts -->
                            <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=MaxSpoofs}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock  HorizontalAlignment="Left" TextWrapping="Wrap" Text="Max Spoofs" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="MaxSpoofs" FontSize="14" Width="60" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" BorderThickness="0,1" BorderBrush="{DynamicResource SecondaryColorBrush}" Foreground="{DynamicResource PrimaryText}" />
                                    <TextBlock Margin="10,0,0,0" Text="max consecutive spoofs (0 = no limit, max 255)" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- matching threshold -->
                            <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=MatchingThreshold}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock  HorizontalAlignment="Left" TextWrapping="Wrap" Text="Matching Threshold" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="MatchThresh" FontSize="14" Width="60" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" BorderThickness="0,1" BorderBrush="{DynamicResource SecondaryColorBrush}" Foreground="{DynamicResource PrimaryText}" />
                                    <TextBlock Margin="10,0,0,0" Text="0=use recommended" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="12" />
                                </StackPanel>
                            </Grid>


                            <!-- sensor exposure and gain settings -->
                            <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=SensorSettings}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock  HorizontalAlignment="Left" TextWrapping="Wrap" Text="Sensor Settings" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0" />
                                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,5,0" Text="Exposure:" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="12" />
                                    <TextBox x:Name="SensorExpTime" FontSize="14" Width="60" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" BorderThickness="0,1" BorderBrush="{DynamicResource SecondaryColorBrush}" Foreground="{DynamicResource PrimaryText}" Margin="0,0,10,0"/> 
                                    <TextBlock Margin="0,0,5,0" Text="    Gain:" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="12" />
                                    <TextBox x:Name="SensorGain" FontSize="14" Width="60" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" BorderThickness="0,1" BorderBrush="{DynamicResource SecondaryColorBrush}" Foreground="{DynamicResource PrimaryText}" />
                                </WrapPanel>
                            </Grid>
                            
                            <!-- GPIO toggle on successful authentication-->
                            <Grid VerticalAlignment="Top" Margin="0,0,0,24" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=GpioToggleAuth}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock  HorizontalAlignment="Left" TextWrapping="Wrap" Text="GPIO Toggling" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0" />
                                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="AuthGpioChk" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Margin="0,0,0,0" Text="authentication success toggles GPIO pin 1" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="12" />
                                </WrapPanel>
                            </Grid>

                            <!-- Face Detection ROI -->
                            <StackPanel x:Name="RoiSection" Visibility="{Binding Mode, Converter={StaticResource ModeToVisibilityConverter}, ConverterParameter=ROI}" Margin="0,0,0,24">
                                <!-- Num ROIs selector -->
                                <Grid VerticalAlignment="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Detection ROIs" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="NumRoisCombo" Width="60" FontSize="14" SelectionChanged="NumRoisCombo_SelectionChanged" Style="{DynamicResource ComboBoxStyle1}" Foreground="{DynamicResource PrimaryText}">
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="3"/>
                                            <ComboBoxItem Content="4"/>
                                            <ComboBoxItem Content="5"/>
                                        </ComboBox>
                                        <TextBlock Margin="10,0,0,0" Text="active ROI(s)" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                                <!-- ROI 1 (index 0) - always visible -->
                                <Grid x:Name="RoiPanel0" VerticalAlignment="Top" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                        <ColumnDefinition Width="1*"/>
